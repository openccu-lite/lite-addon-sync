# The rclone the addon ships: upstream's release binary, pinned by version and by the SHA-256 of
# upstream's zip per architecture (from https://downloads.rclone.org/<version>/SHA256SUMS).
# scripts/fetch-rclone.sh refuses a download that does not match. The follow-rclone workflow
# rewrites this file when upstream releases.
RCLONE_VERSION=v1.76.0
RCLONE_SHA256_x86_64=b00f00b3266c3764413afe599d3ec316f6f43b3e0ea8a0bc1d186d2133e46df7
RCLONE_SHA256_aarch64=ee169016675e23a69d77240565133ff7dbc9b33d16fa8f7053d4af39f1eaeb78
